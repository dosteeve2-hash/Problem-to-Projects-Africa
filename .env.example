# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/problem_to_project

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
API_SECRET_KEY=your-secret-key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# AI Provider: "claude" | "ollama" | leave empty for local heuristic engine
AI_PROVIDER=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Analytics
NEXT_PUBLIC_GA_ID=your-google-analytics-id

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SOCIAL_LOGIN=true

# App Configuration
NEXT_PUBLIC_APP_NAME=Problem to Project Africa
NEXT_PUBLIC_APP_URL=https://problemtoproject.africa
NODE_ENV=development
